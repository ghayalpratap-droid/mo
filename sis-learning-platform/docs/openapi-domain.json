  "components": {
    "schemas": {
      "CsvUpload": {
        "type": "object",
        "properties": {
          "csv": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 0
          }
        },
        "required": [
          "csv"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "Intake": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "pattern": "[AB]"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9-]{1,80}"
          },
          "studentName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "UG|PGL|PGD|PGNI|APPLY_ONCE|LLE"
          },
          "courseId": {
            "type": "string",
            "minLength": 1
          },
          "academicYear": {
            "type": "integer",
            "format": "int32",
            "maximum": 2040,
            "minimum": 2020
          },
          "fee": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0
          }
        },
        "required": [
          "courseId",
          "fee",
          "provider",
          "source",
          "sourceRef",
          "studentName"
        ]
      },
      "View": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "studentName": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "academicYear": {
            "type": "integer",
            "format": "int32"
          },
          "fee": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "registration": {
            "type": "string"
          },
          "attendance": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "credits": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "CONFIRMED|NOT_ATTENDING"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "Change": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "WITHDRAWAL|SUSPENSION|RESUMPTION|CANCELLATION|FEE_CHANGE|FEE_WAIVER|CREDITS|COURSE_TRANSFER|PROVIDER_TRANSFER"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          },
          "targetCourse": {
            "type": "string"
          },
          "credits": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "effectiveDate",
          "type",
          "version"
        ]
      },
      "Preview": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policy": {
            "type": "string"
          }
        }
      },
      "Identity": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
